<Project Sdk="Microsoft.NET.Sdk">
  <!-- UN6t: the founder trainer and evaluator (god-train). Dependency-free C# (no ML framework); references God.Sim only.
       Nothing under Assets/God/Sim references this project. The teacher lives here and in test fixtures only.
       Target framework net10.0 like God.Runner (R86; the design's "net8" is superseded). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>God.Train</RootNamespace>
    <AssemblyName>god-train</AssemblyName>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../God.Sim/God.Sim.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Curriculum/*.json" CopyToOutputDirectory="PreserveNewest" LinkBase="Curriculum" />
  </ItemGroup>
</Project>
