<Project Sdk="Microsoft.NET.Sdk">
  <!-- The headless runner (HEADLESS_SIMULATION): run, batch, verify, replay, bench. It never compiles sim sources itself:
       one build of the rules, through the God.Sim project. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>God.Runner</RootNamespace>
    <AssemblyName>God.Runner</AssemblyName>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../God.Sim/God.Sim.csproj" />
    <ProjectReference Include="../God.Recording/God.Recording.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Parquet.Net" Version="6.1.0" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.14" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Warehouse/Migrations/*.sql" LogicalName="Migrations/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Warehouse/post_load.sql" LogicalName="post_load.sql" />
    <None Include="Warehouse/ExampleQueries.sql" CopyToOutputDirectory="PreserveNewest" LinkBase="Warehouse" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Scenarios/*.json" CopyToOutputDirectory="PreserveNewest" LinkBase="Scenarios" />
    <None Include="Bench/*.json" CopyToOutputDirectory="PreserveNewest" LinkBase="Bench" />
  </ItemGroup>
</Project>
