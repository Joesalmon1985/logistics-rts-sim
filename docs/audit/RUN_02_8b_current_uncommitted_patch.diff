diff --git a/godot_project/sim/tools/run_economy_bvb_site_debug.gd b/godot_project/sim/tools/run_economy_bvb_site_debug.gd
new file mode 100644
index 0000000..5d886e7
--- /dev/null
+++ b/godot_project/sim/tools/run_economy_bvb_site_debug.gd
@@ -0,0 +1,44 @@
+extends SceneTree
+
+const BootstrapScript := preload("res://sim/core/sim_bootstrap.gd")
+
+
+func _initialize() -> void:
+	BootstrapScript.load_all()
+	var scenario: Dictionary = EconomyBvbSetup.expansion_duel_scenario(EconomyBvbSetup.PROFILE_PROOF)
+	scenario["max_ticks"] = 601
+	var runner := SimulationTickRunner.new()
+	var state: GameState = runner.create_game(scenario)
+	EconomyBvbSetup.prepare_expansion_duel_map(state, scenario)
+	var dual := DualBotRunner.new(runner)
+	state = dual.run_match(state, scenario)
+	for pid in ["p1", "p2"]:
+		print("=== %s tick=%d ===" % [pid, state.tick])
+		for site in EconomyState.all_construction_sites(state):
+			if str(site.get("player_id", "")) != pid:
+				continue
+			print("site id=%s type=%s state=%s delivered=%s required=%s builder_work=%s" % [
+				site.get("id", 0),
+				site.get("building_type", ""),
+				site.get("state", ""),
+				str(site.get("delivered", {})),
+				str(site.get("required", {})),
+				site.get("builder_work_remaining", 0),
+			])
+		for building in EconomyState.all_buildings(state):
+			if str(building.get("player_id", "")) != pid:
+				continue
+			if str(building.get("building_type", "")) == "headquarters":
+				continue
+			print("building id=%s type=%s state=%s" % [
+				building.get("id", 0),
+				building.get("building_type", ""),
+				building.get("state", ""),
+			])
+		print("buildings_built=%d roads=%d deliveries=%d" % [
+			DualBotRunner.count_player_buildings_built(state, pid),
+			DualBotRunner.count_player_roads_built(state, pid),
+			DualBotRunner.count_player_deliveries_built(state, pid),
+		])
+	print("EXIT: 0 (pass)")
+	quit(0)
