class_name MilitaryTick
extends RefCounted

## Per-tick military subsystem dispatch. The fixed order (DDR / RUN_03 plan §8):
##   meta -> power -> resources -> tech -> construction -> production -> orders
##   -> movement -> vision -> combat -> damage -> repair -> victory
##   -> diagnostics -> statistics
## Rationale: power is computed first so all gated systems (construction,
## production, research, repair, turret firing) see the current power state.
## Credits generated by resources this tick are available to spenders the same
## tick. Vision updates after movement so combat fires against fresh positions.


static func get_subsystem_order() -> Array[String]:
	return [
		"meta",
		"power",
		"resources",
		"tech",
		"construction",
		"production",
		"orders",
		"movement",
		"vision",
		"combat",
		"damage",
		"repair",
		"victory",
		"diagnostics",
		"statistics",
	]


static func step_subsystem(name: String, state: GameState, _rng: SeededRng) -> void:
	match name:
		"meta":
			_step_meta(state)
		"power":
			MilitaryPowerSystem.tick(state)
		"resources":
			MilitaryResourceSystem.tick(state)
		"tech":
			MilitaryTechSystem.tick(state)
		"construction":
			MilitaryConstructionSystem.tick(state)
		"production":
			MilitaryProductionSystem.tick(state)
		"orders":
			MilitaryOrderSystem.tick(state)
		"movement":
			MilitaryMovementSystem.tick(state)
		"vision":
			MilitaryVisionSystem.tick(state)
		"combat":
			MilitaryCombatSystem.tick_combat(state)
		"damage":
			MilitaryCombatSystem.tick_damage(state)
		"repair":
			MilitaryRepairSystem.tick(state)
		"victory":
			MilitaryVictorySystem.tick(state)
		"diagnostics":
			MilitaryDiagnosticsSystem.tick(state)
		"statistics":
			MilitaryDiagnosticsSystem.tick_statistics(state)
		_:
			push_warning("MilitaryTick: unknown subsystem %s" % name)


static func _step_meta(state: GameState) -> void:
	MilitaryState.ensure_buckets(state)
	MilitaryState.set_meta_value(state, "pending_damage", [])
