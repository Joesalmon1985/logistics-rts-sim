*.tmp
*.log
.DS_Store
.env
.env.*
__pycache__/

# Unity
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
