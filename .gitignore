# Anything derived from Sims 2 / EA material or local-only assets: NEVER commit
/LocalData/
/LocalAssets/
/Assets/LocalBaked/
/Assets/LocalBaked.meta
*.package
*.simpkg
*.dbpf

# Fast out-of-Unity test harness (DotNet/): keep projects and solution, ignore build output
!/DotNet/**/*.csproj
!/DotNet/*.sln
DotNet/**/bin/
DotNet/**/obj/
